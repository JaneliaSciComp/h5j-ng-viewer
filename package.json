{
  "name": "h5j-ng-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only H5J to OME-Zarr to Neuroglancer viewer",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "dev:https": "HTTPS=1 vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 --fix && tsc",
    "format": "prettier --config .prettierrc '**/*.{cjs,js,jsx,ts,tsx,md,json}' --check",
    "format:fix": "prettier --config .prettierrc '**/*.{cjs,js,jsx,ts,tsx,md,json}' --write"
  },
  "dependencies": {
    "@ffmpeg/core": "0.10.0",
    "@ffmpeg/ffmpeg": "^0.10.1",
    "@janelia/react-neuroglancer": "^0.0.1",
    "@janelia/web-h5j-loader": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
